{
  "manifest_version": 3,
  "name": "Auto Clicker Pro",
  "version": "3.1.0",
  "description": "Auto-click page elements with multiple trigger types, flexible run modes, and config management. 自动点击页面元素，支持多种触发方式和配置管理。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
